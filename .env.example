# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL="https://desertsafaridxbpro.com"

# Google Gemini AI Concierge (Server-side only — never expose in client bundle)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

# Gmail SMTP Gateway for Booking Confirmation Vouchers & Admin Alerts
GMAIL_USER="info@desertsafaridxbpro.com"
GMAIL_APP_PASSWORD="YOUR_GMAIL_APP_PASSWORD_HERE"

# B2B.Tickets / Traveldesk Supplier Integration (Server-side Bearer JWT)
B2B_TICKETS_API_KEY="YOUR_B2B_TICKETS_JWT_TOKEN_HERE"

# Operator Admin Portal Authentication (Server-side & Admin API protection)
ADMIN_EMAIL="info@desertsafaridxbpro.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
ADMIN_API_TOKEN="REPLACE_WITH_RANDOM_SERVER_ADMIN_TOKEN"

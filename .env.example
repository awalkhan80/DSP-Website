# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL_USER: Sender email for automated booking vouchers and operator notifications.
GMAIL_USER="awalgsm@gmail.com"

# GMAIL_APP_PASSWORD: 16-character Google App Password for Gmail SMTP gateway.
GMAIL_APP_PASSWORD="your-google-app-password"



# Phoenix AI assistant (server-side secrets only; never use VITE_ prefixes)
OPENAI_API_KEY=
OPENAI_MODEL=
APP_ORIGIN=https://desertsafaridxbpro.com
AGENT_ADMIN_TOKEN=
AGENT_DB_HOST=
AGENT_DB_PORT=3306
AGENT_DB_NAME=
AGENT_DB_USER=
AGENT_DB_PASSWORD=
AGENT_DB_SSL=false
# Set only to the verified number of trusted reverse proxies at your host.
TRUST_PROXY_HOPS=
